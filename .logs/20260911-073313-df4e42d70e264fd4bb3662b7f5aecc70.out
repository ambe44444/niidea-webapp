.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg><h3 class="text-lg font-bold leading-snug text-white">Y muchos más</h3><p class="text-[13px] leading-relaxed text-gray-400">El catálogo cambia cada semana. Lo tuyo puede no estar aquí.</p></article></div></div></section><section class="mx-auto max-w-6xl px-6 py-16"><h2 class="text-center text-3xl font-extrabold">Elige tu nivel</h2><p class="mt-2 text-center text-white/50">Tú decides la intensidad. Nosotros el plan.</p><div class="mt-10 grid gap-5 md:grid-cols-3"><div class="relative rounded-2xl border p-6 transition-colors border-white/10 bg-white/[0.02]"><p class="text-lg font-bold text-white">Soft</p><p class="mt-1 text-sm text-white/50">Plan tranquilo</p><p class="mt-4 text-3xl font-extrabold" style="color:#FFD54F">25€<span class="ml-1 text-sm font-normal text-white/40">/ persona</span></p></div><div class="relative rounded-2xl border p-6 transition-colors bg-white/[0.04]" style="border-color:#FFD54F"><span class="absolute -top-2.5 right-5 rounded px-2 py-0.5 text-[10px] font-bold text-black" style="background:#FFD54F">POPULAR</span><p class="text-lg font-bold text-white">Medium</p><p class="mt-1 text-sm text-white/50">Plan sorpresa top</p><p class="mt-4 text-3xl font-extrabold" style="color:#FFD54F">30€<span class="ml-1 text-sm font-normal text-white/40">/ persona</span></p></div><div class="relative rounded-2xl border p-6 transition-colors border-white/10 bg-white/[0.02]"><p class="text-lg font-bold text-white">Full</p><p class="mt-1 text-sm text-white/50">Experiencia loca</p><p class="mt-4 text-3xl font-extrabold" style="color:#FFD54F">35€<span class="ml-1 text-sm font-normal text-white/40">/ persona</span></p></div></div></section><section class="mx-auto max-w-6xl px-6 py-16"><h2 class="text-center text-3xl font-extrabold">Lo que dicen de nosotros</h2><p class="mt-2 text-center text-white/50">Experiencias reales de gente que se dejó sorprender en Madrid</p><div><div class="mt-10 columns-1 gap-5 space-y-5 sm:columns-2 lg:columns-3"><div class="break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5"><div class="mb-3 flex items-center gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-black" style="background:#FFD54F">M</div><div><p class="text-sm font-semibold text-white">Marta G.</p><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><span class="ml-1 text-[10px] text-white/30">Medium</span></div></div></div><p class="text-[13px] leading-relaxed text-white/60">No tenía ni idea de lo que íbamos a hacer y fue lo mejor. Cenamos en un sitio increíble y acabamos en un speakeasy secreto. ¡Repetimos seguro!</p></div><div class="break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5"><div class="mb-3 flex items-center gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-black" style="background:#FFD54F">C</div><div><p class="text-sm font-semibold text-white">Carlos R.</p><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><span class="ml-1 text-[10px] text-white/30">Full</span></div></div></div><p class="text-[13px] leading-relaxed text-white/60">Organizamos la despedida de mi mejor amigo con NiIdea. La experiencia Full superó todas las expectativas. No puedo dar detalles porque arruinaría la sorpresa 😏</p></div><div class="break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5"><div class="mb-3 flex items-center gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-black" style="background:#FFD54F">L</div><div><p class="text-sm font-semibold text-white">Laura M.</p><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><span class="ml-1 text-[10px] text-white/30">Soft</span></div></div></div><p class="text-[13px] leading-relaxed text-white/60">Plan tranquilo pero muy currado. Nos llevaron a un sitio que jamás habríamos descubierto solos. Perfecto para una cita.</p></div><div class="break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5"><div class="mb-3 flex items-center gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-black" style="background:#FFD54F">J</div><div><p class="text-sm font-semibold text-white">Javi P.</p><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><span class="ml-1 text-[10px] text-white/30">Medium</span></div></div></div><p class="text-[13px] leading-relaxed text-white/60">La incertidumbre es lo mejor. Pasamos toda la semana intentando adivinar qué sería y al final fue algo completamente diferente. Genial.</p></div><div class="break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5"><div class="mb-3 flex items-center gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-black" style="background:#FFD54F">A</div><div><p class="text-sm font-semibold text-white">Andrea S.</p><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><span class="ml-1 text-[10px] text-white/30">Full</span></div></div></div><p class="text-[13px] leading-relaxed text-white/60">Éramos 6 y nos organizaron una noche que parecía sacada de una peli. Cada detalle pensado. La mejor inversión de 35€ de mi vida.</p></div><div class="break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5"><div class="mb-3 flex items-center gap-3"><div class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-black" style="background:#FFD54F">P</div><div><p class="text-sm font-semibold text-white">Pablo D.</p><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3 w-3 fill-current" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg><span class="ml-1 text-[10px] text-white/30">Medium</span></div></div></div><p class="text-[13px] leading-relaxed text-white/60">Le regalé una experiencia NiIdea a mi pareja por su cumple. Ella flipó. Dice que ha sido el mejor regalo que le han hecho nunca.</p></div></div><div class="mt-8 flex justify-center"><button type="button" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/30 hover:bg-white/[0.08]">Ver más reseñas (<!-- -->14<!-- -->)<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4"><path d="m6 9 6 6 6-6"></path></svg></button></div></div><div class="mt-10 text-center"><button type="button" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4 w-4" style="color:#FFD54F"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>Escribe tu reseña</button></div></section><section id="faq" class="mx-auto max-w-3xl px-6 py-16"><h2 class="text-center text-3xl font-extrabold">Preguntas frecuentes</h2><p class="mt-2 text-center text-white/50">Lo que nos preguntáis antes de atreveros.</p><div class="mt-10 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]"><div><button type="button" aria-expanded="true" class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition hover:bg-white/[0.03]"><span class="text-sm font-semibold text-white sm:text-base">¿Qué tipo de experiencias me puede tocar?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 shrink-0 transition-transform rotate-180" style="color:#FFD54F"><path d="m6 9 6 6 6-6"></path></svg></button><div class="px-5 pb-5 text-[13px] leading-relaxed text-white/60">Cenas en restaurantes con carácter, teatro y microteatro, bares de coctelería escondidos, azoteas con vistas, talleres (cerámica, cata, cocina), planes de ocio tipo juegos o escape, y noches que acaban bailando. También spa y masajes cuando están en el centro de Madrid y se pueden reservar online. Todo es en Madrid y todo se elige según el nivel que compres: Soft (tranquilo), Medium (sorpresa top) o Full (más intenso).</div></div><div><button type="button" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition hover:bg-white/[0.03]"><span class="text-sm font-semibold text-white sm:text-base">¿Y si el plan no me gusta?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 shrink-0 transition-transform " style="color:#FFD54F"><path d="m6 9 6 6 6-6"></path></svg></button></div><div><button type="button" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition hover:bg-white/[0.03]"><span class="text-sm font-semibold text-white sm:text-base">¿Se devuelve el dinero?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 shrink-0 transition-transform " style="color:#FFD54F"><path d="m6 9 6 6 6-6"></path></svg></button></div><div><button type="button" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition hover:bg-white/[0.03]"><span class="text-sm font-semibold text-white sm:text-base">¿Y si al final no podemos ir?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 shrink-0 transition-transform " style="color:#FFD54F"><path d="m6 9 6 6 6-6"></path></svg></button></div><div><button type="button" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition hover:bg-white/[0.03]"><span class="text-sm font-semibold text-white sm:text-base">¿Cuándo sé dónde tengo que ir?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 shrink-0 transition-transform " style="color:#FFD54F"><path d="m6 9 6 6 6-6"></path></svg></button></div><div><button type="button" aria-expanded="false" class="flex w-full items-center justify-between gap-4 px-5 py-5 text-left transition hover:bg-white/[0.03]"><span class="text-sm font-semibold text-white sm:text-base">¿Qué incluye el precio?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-5 w-5 shrink-0 transition-transform " style="color:#FFD54F"><path d="m6 9 6 6 6-6"></path></svg></button></div></div></section><section class="mx-auto max-w-6xl px-6 py-16"><div class="grid gap-10 lg:grid-cols-[1fr_320px] lg:items-center"><div><h2 class="mb-10 text-2xl font-extrabold">¿Cómo funciona?</h2><div class="flex flex-col items-stretch gap-8 sm:flex-row sm:items-start"><div class="flex flex-1 flex-col items-center text-center"><div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full border" style="border-color:rgba(255,213,79,0.4)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-cart h-6 w-6" style="color:#FFD54F"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg></div><p class="text-sm font-semibold text-white">1<!-- -->. <!-- -->Compras</p><p class="mt-1 max-w-[180px] text-xs text-white/50">Eliges fecha, personas y nivel de experiencia.</p></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-5 w-5 shrink-0 self-center text-white/30 sm:block"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex flex-1 flex-col items-center text-center"><div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full border" style="border-color:rgba(255,213,79,0.4)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gift h-6 w-6" style="color:#FFD54F"><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"></path></svg></div><p class="text-sm font-semibold text-white">2<!-- -->. <!-- -->Preparamos</p><p class="mt-1 max-w-[180px] text-xs text-white/50">Seleccionamos el mejor plan sorpresa para ti.</p></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-5 w-5 shrink-0 self-center text-white/30 sm:block"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex flex-1 flex-col items-center text-center"><div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full border" style="border-color:rgba(255,213,79,0.4)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle h-6 w-6" style="color:#FFD54F"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg></div><p class="text-sm font-semibold text-white">3<!-- -->. <!-- -->Te avisamos</p><p class="mt-1 max-w-[180px] text-xs text-white/50">El día antes te enviamos todos los detalles por email.</p></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden h-5 w-5 shrink-0 self-center text-white/30 sm:block"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex flex-1 flex-col items-center text-center"><div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full border" style="border-color:rgba(255,213,79,0.4)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smile h-6 w-6" style="color:#FFD54F"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" x2="9.01" y1="9" y2="9"></line><line x1="15" x2="15.01" y1="9" y2="9"></line></svg></div><p class="text-sm font-semibold text-white">4<!-- -->. <!-- -->Disfrutas</p><p class="mt-1 max-w-[180px] text-xs text-white/50">Vive la experiencia sin saber nada más. Solo disfruta.</p></div></div></div><div class="rounded-2xl bg-[#171717] p-8"><p class="text-xl font-bold leading-snug text-white">Hecho para los que buscan algo diferente.</p><a class="mt-4 inline-flex items-center gap-2 text-lg font-bold transition-transform hover:translate-x-1" style="color:#FFD54F" href="/buy">¿Te atreves a no saber?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-5 w-5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><footer class="border-t border-white/10"><div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-10"><div class="flex w-full flex-col items-center justify-between gap-4 sm:flex-row"><span class="font-script text-2xl" style="color:#FFD54F">Niidea</span><p class="flex items-center gap-2 text-xs text-white/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock h-3.5 w-3.5"><rect width="18" height="11" x="3" y=